# DropVid 官网静态站（dropvid.cn）
# API 走独立域名 api.dropvid.cn，见 crazy-dropVid-server/deploy/nginx/api.dropvid.cn.conf
#
# 安装：
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/dropvid.cn.conf
#   sudo ln -sf /etc/nginx/sites-available/dropvid.cn.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream dropvid_api {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    server_name dropvid.cn www.dropvid.cn;

    root /opt/dropvid/site/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;

    # 同域反代 API：QQ 内置浏览器跨域 fetch 更稳定；构建时 VITE_API_BASE_URL=same-origin
    location /api/ {
        proxy_pass http://dropvid_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /config/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300";
    }

    location /update/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=120";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

