{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@dropvid/shared": ["./packages/shared/src/index.ts"],
      "@dropvid/shared/*": ["./packages/shared/src/*"],
      "@dropvid/ui": ["./packages/ui/src/index.ts"],
      "@dropvid/ui/*": ["./packages/ui/src/*"],
      "@dropvid/account": ["./packages/account/src/index.ts"],
      "@dropvid/account/*": ["./packages/account/src/*"],
      "@dropvid/site": ["./packages/site/src/index.ts"],
      "@dropvid/site/*": ["./packages/site/src/*"]
    }
  },
  "include": ["src", "packages/shared/src", "packages/ui/src", "packages/account/src", "packages/site/src"]
}
